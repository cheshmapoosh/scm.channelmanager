<included>
    <if condition='property("TRACE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("TRACE_FILE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("TRACE_FILE_FORMAT").equalsIgnoreCase("jsonl")'>
        <then>
            <if condition='property("TRACE_ASYNC_ENABLED").equalsIgnoreCase("true")'>
                <then>
                    <appender name="SCM_TRACE_JSONL_FILE"
                              class="ch.qos.logback.core.rolling.RollingFileAppender">
                        <file>${TRACE_LOG_FILE}</file>
                        <append>true</append>
                        <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                            <marker>SCM_OBSERVATION_TRACE</marker>
                        </filter>
                        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                            <fileNamePattern>${TRACE_ARCHIVE_PATTERN}</fileNamePattern>
                            <maxFileSize>${TRACE_MAX_FILE_SIZE}</maxFileSize>
                            <maxHistory>${TRACE_MAX_HISTORY}</maxHistory>
                            <totalSizeCap>${TRACE_TOTAL_SIZE_CAP}</totalSizeCap>
                            <cleanHistoryOnStart>${TRACE_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                        </rollingPolicy>
                        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                            <providers>
                                <provider class="ir.daneshrefah.scm.observation.logging.ScmObservationEventJsonProvider"/>
                            </providers>
                        </encoder>
                    </appender>
                    <appender name="SCM_TRACE_JSONL"
                              class="ch.qos.logback.classic.AsyncAppender">
                        <queueSize>${TRACE_ASYNC_QUEUE_SIZE}</queueSize>
                        <discardingThreshold>${TRACE_ASYNC_DISCARDING_THRESHOLD}</discardingThreshold>
                        <neverBlock>${TRACE_ASYNC_NEVER_BLOCK}</neverBlock>
                        <maxFlushTime>${TRACE_ASYNC_MAX_FLUSH_TIME}</maxFlushTime>
                        <appender-ref ref="SCM_TRACE_JSONL_FILE"/>
                    </appender>
                </then>
                <else>
                    <appender name="SCM_TRACE_JSONL"
                              class="ch.qos.logback.core.rolling.RollingFileAppender">
                        <file>${TRACE_LOG_FILE}</file>
                        <append>true</append>
                        <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                            <marker>SCM_OBSERVATION_TRACE</marker>
                        </filter>
                        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                            <fileNamePattern>${TRACE_ARCHIVE_PATTERN}</fileNamePattern>
                            <maxFileSize>${TRACE_MAX_FILE_SIZE}</maxFileSize>
                            <maxHistory>${TRACE_MAX_HISTORY}</maxHistory>
                            <totalSizeCap>${TRACE_TOTAL_SIZE_CAP}</totalSizeCap>
                            <cleanHistoryOnStart>${TRACE_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                        </rollingPolicy>
                        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                            <providers>
                                <provider class="ir.daneshrefah.scm.observation.logging.ScmObservationEventJsonProvider"/>
                            </providers>
                        </encoder>
                    </appender>
                </else>
            </if>
        </then>
        <else>
            <appender name="SCM_TRACE_JSONL"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
</included>
