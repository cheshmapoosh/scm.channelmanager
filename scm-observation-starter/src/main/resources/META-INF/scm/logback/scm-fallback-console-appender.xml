<included>
    <if condition='!property("OBSERVATION_ENABLED").equalsIgnoreCase("true")
        || !property("LOG_ENABLED").equalsIgnoreCase("true")'>
        <then>
            <appender name="SCM_FALLBACK_CONSOLE"
                      class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_TRACE</marker>
                    <inverse>true</inverse>
                </filter>
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_AUDIT</marker>
                    <inverse>true</inverse>
                </filter>
                <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="SCM_FALLBACK_CONSOLE"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
</included>
