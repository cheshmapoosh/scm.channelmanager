<included>
    <if condition='property("LOG_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_CONSOLE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_CONSOLE_FORMAT").equalsIgnoreCase("jsonl")'>
        <then>
            <appender name="SCM_CONSOLE_JSONL"
                      class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_TRACE</marker>
                    <inverse>true</inverse>
                </filter>
                <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_AUDIT</marker>
                    <inverse>true</inverse>
                </filter>
                <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                    <providers>
                        <provider class="ir.daneshrefah.scm.observation.logging.ScmLogJsonProvider"/>
                    </providers>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="SCM_CONSOLE_JSONL"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
    <if condition='property("TRACE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("TRACE_CONSOLE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("TRACE_CONSOLE_FORMAT").equalsIgnoreCase("jsonl")'>
        <then>
            <appender name="SCM_TRACE_CONSOLE_JSONL"
                      class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_TRACE</marker>
                </filter>
                <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                    <providers>
                        <provider class="ir.daneshrefah.scm.observation.logging.ScmObservationEventJsonProvider"/>
                    </providers>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="SCM_TRACE_CONSOLE_JSONL"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
    <if condition='property("AUDIT_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("AUDIT_CONSOLE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("AUDIT_CONSOLE_FORMAT").equalsIgnoreCase("jsonl")'>
        <then>
            <appender name="SCM_AUDIT_CONSOLE_JSONL"
                      class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_AUDIT</marker>
                </filter>
                <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                    <providers>
                        <provider class="ir.daneshrefah.scm.observation.logging.ScmObservationEventJsonProvider"/>
                    </providers>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="SCM_AUDIT_CONSOLE_JSONL"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
</included>
