<included>
    <if condition='property("OBSERVATION_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_FILE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_FILE_FORMAT").equals("simple")'>
        <then>
            <appender name="SCM_FILE_SIMPLE"
                      class="ch.qos.logback.core.rolling.RollingFileAppender">
                <append>true</append>
                <file>${LOG_SIMPLE_CURRENT_FILE}</file>
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_TRACE</marker>
                    <inverse>true</inverse>
                </filter>
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_AUDIT</marker>
                    <inverse>true</inverse>
                </filter>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_SIMPLE_ROLLED_FILE_PATTERN}</fileNamePattern>
                    <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
                    <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
                    <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
                    <cleanHistoryOnStart>${LOG_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                </rollingPolicy>
                <encoder class="ir.daneshrefah.scm.observation.starter.logging.ScmLogSimpleEncoder"/>
            </appender>
        </then>
        <else>
            <appender name="SCM_FILE_SIMPLE"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
    <if condition='property("OBSERVATION_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("TRACE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("TRACE_FILE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("TRACE_FILE_FORMAT").equals("simple")'>
        <then>
            <if condition='property("TRACE_ASYNC_ENABLED").equalsIgnoreCase("true")'>
                <then>
                    <appender name="SCM_TRACE_SIMPLE_FILE"
                              class="ch.qos.logback.core.rolling.RollingFileAppender">
                        <append>true</append>
                        <file>${TRACE_SIMPLE_CURRENT_FILE}</file>
                        <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                            <marker>SCM_OBSERVATION_TRACE</marker>
                        </filter>
                        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                            <fileNamePattern>${TRACE_SIMPLE_ROLLED_FILE_PATTERN}</fileNamePattern>
                            <maxFileSize>${TRACE_MAX_FILE_SIZE}</maxFileSize>
                            <maxHistory>${TRACE_MAX_HISTORY}</maxHistory>
                            <totalSizeCap>${TRACE_TOTAL_SIZE_CAP}</totalSizeCap>
                            <cleanHistoryOnStart>${TRACE_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                        </rollingPolicy>
                        <encoder class="ir.daneshrefah.scm.observation.starter.logging.ScmObservationSimpleEncoder"/>
                    </appender>
                    <appender name="SCM_TRACE_SIMPLE"
                              class="ch.qos.logback.classic.AsyncAppender">
                        <queueSize>${TRACE_ASYNC_QUEUE_SIZE}</queueSize>
                        <discardingThreshold>${TRACE_ASYNC_DISCARDING_THRESHOLD}</discardingThreshold>
                        <neverBlock>${TRACE_ASYNC_NEVER_BLOCK}</neverBlock>
                        <maxFlushTime>${TRACE_ASYNC_MAX_FLUSH_TIME}</maxFlushTime>
                        <appender-ref ref="SCM_TRACE_SIMPLE_FILE"/>
                    </appender>
                </then>
                <else>
                    <appender name="SCM_TRACE_SIMPLE"
                              class="ch.qos.logback.core.rolling.RollingFileAppender">
                        <append>true</append>
                        <file>${TRACE_SIMPLE_CURRENT_FILE}</file>
                        <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                            <marker>SCM_OBSERVATION_TRACE</marker>
                        </filter>
                        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                            <fileNamePattern>${TRACE_SIMPLE_ROLLED_FILE_PATTERN}</fileNamePattern>
                            <maxFileSize>${TRACE_MAX_FILE_SIZE}</maxFileSize>
                            <maxHistory>${TRACE_MAX_HISTORY}</maxHistory>
                            <totalSizeCap>${TRACE_TOTAL_SIZE_CAP}</totalSizeCap>
                            <cleanHistoryOnStart>${TRACE_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                        </rollingPolicy>
                        <encoder class="ir.daneshrefah.scm.observation.starter.logging.ScmObservationSimpleEncoder"/>
                    </appender>
                </else>
            </if>
        </then>
        <else>
            <appender name="SCM_TRACE_SIMPLE"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
    <if condition='property("OBSERVATION_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("AUDIT_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("AUDIT_FILE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("AUDIT_FILE_FORMAT").equals("simple")'>
        <then>
            <if condition='property("AUDIT_ASYNC_ENABLED").equalsIgnoreCase("true")'>
                <then>
                    <appender name="SCM_AUDIT_SIMPLE_FILE"
                              class="ch.qos.logback.core.rolling.RollingFileAppender">
                        <append>true</append>
                        <file>${AUDIT_SIMPLE_CURRENT_FILE}</file>
                        <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                            <marker>SCM_OBSERVATION_AUDIT</marker>
                        </filter>
                        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                            <fileNamePattern>${AUDIT_SIMPLE_ROLLED_FILE_PATTERN}</fileNamePattern>
                            <maxFileSize>${AUDIT_MAX_FILE_SIZE}</maxFileSize>
                            <maxHistory>${AUDIT_MAX_HISTORY}</maxHistory>
                            <totalSizeCap>${AUDIT_TOTAL_SIZE_CAP}</totalSizeCap>
                            <cleanHistoryOnStart>${AUDIT_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                        </rollingPolicy>
                        <encoder class="ir.daneshrefah.scm.observation.starter.logging.ScmObservationSimpleEncoder"/>
                    </appender>
                    <appender name="SCM_AUDIT_SIMPLE"
                              class="ch.qos.logback.classic.AsyncAppender">
                        <queueSize>${AUDIT_ASYNC_QUEUE_SIZE}</queueSize>
                        <discardingThreshold>${AUDIT_ASYNC_DISCARDING_THRESHOLD}</discardingThreshold>
                        <neverBlock>${AUDIT_ASYNC_NEVER_BLOCK}</neverBlock>
                        <maxFlushTime>${AUDIT_ASYNC_MAX_FLUSH_TIME}</maxFlushTime>
                        <appender-ref ref="SCM_AUDIT_SIMPLE_FILE"/>
                    </appender>
                </then>
                <else>
                    <appender name="SCM_AUDIT_SIMPLE"
                              class="ch.qos.logback.core.rolling.RollingFileAppender">
                        <append>true</append>
                        <file>${AUDIT_SIMPLE_CURRENT_FILE}</file>
                        <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                            <marker>SCM_OBSERVATION_AUDIT</marker>
                        </filter>
                        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                            <fileNamePattern>${AUDIT_SIMPLE_ROLLED_FILE_PATTERN}</fileNamePattern>
                            <maxFileSize>${AUDIT_MAX_FILE_SIZE}</maxFileSize>
                            <maxHistory>${AUDIT_MAX_HISTORY}</maxHistory>
                            <totalSizeCap>${AUDIT_TOTAL_SIZE_CAP}</totalSizeCap>
                            <cleanHistoryOnStart>${AUDIT_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                        </rollingPolicy>
                        <encoder class="ir.daneshrefah.scm.observation.starter.logging.ScmObservationSimpleEncoder"/>
                    </appender>
                </else>
            </if>
        </then>
        <else>
            <appender name="SCM_AUDIT_SIMPLE"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
</included>
