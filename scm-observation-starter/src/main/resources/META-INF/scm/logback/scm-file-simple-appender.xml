<included>
    <if condition='property("LOG_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_FILE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_FILE_FORMAT").equalsIgnoreCase("simple")'>
        <then>
            <appender name="SCM_FILE_SIMPLE"
                      class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${APPLICATION_LOG_FILE}</file>
                <append>true</append>
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_TRACE</marker>
                    <inverse>true</inverse>
                </filter>
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_AUDIT</marker>
                    <inverse>true</inverse>
                </filter>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${APPLICATION_ARCHIVE_PATTERN}</fileNamePattern>
                    <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
                    <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
                    <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
                    <cleanHistoryOnStart>${LOG_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                </rollingPolicy>
                <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                    <charset>UTF-8</charset>
                    <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="SCM_FILE_SIMPLE"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
</included>
