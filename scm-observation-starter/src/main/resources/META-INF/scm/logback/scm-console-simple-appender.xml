<included>
    <if condition='property("LOG_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_CONSOLE_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_CONSOLE_FORMAT").equalsIgnoreCase("simple")'>
        <then>
            <appender name="SCM_CONSOLE_SIMPLE"
                      class="ch.qos.logback.core.ConsoleAppender">
                <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_TRACE</marker>
                    <inverse>true</inverse>
                </filter>
                <filter class="ir.daneshrefah.scm.observation.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_AUDIT</marker>
                    <inverse>true</inverse>
                </filter>
                <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                    <charset>UTF-8</charset>
                    <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="SCM_CONSOLE_SIMPLE"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
</included>
