<included>
    <if condition='property("OBSERVATION_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_ENABLED").equalsIgnoreCase("true")
        &amp;&amp; property("LOG_FILE_ENABLED").equalsIgnoreCase("true")'>
        <then>
            <appender name="SCM_FILE_JSONL"
                      class="ch.qos.logback.core.rolling.RollingFileAppender">
                <append>true</append>
                <file>${LOG_JSONL_CURRENT_FILE}</file>
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_TRACE</marker>
                    <inverse>true</inverse>
                </filter>
                <filter class="ir.daneshrefah.scm.observation.starter.logback.ObservationMarkerFilter">
                    <marker>SCM_OBSERVATION_AUDIT</marker>
                    <inverse>true</inverse>
                </filter>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_JSONL_ROLLED_FILE_PATTERN}</fileNamePattern>
                    <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
                    <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
                    <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
                    <cleanHistoryOnStart>${LOG_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                </rollingPolicy>
                <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                    <providers>
                        <provider class="ir.daneshrefah.scm.observation.starter.logging.ScmLogJsonProvider"/>
                    </providers>
                </encoder>
            </appender>
        </then>
        <else>
            <appender name="SCM_FILE_JSONL"
                      class="ch.qos.logback.core.helpers.NOPAppender"/>
        </else>
    </if>
</included>
