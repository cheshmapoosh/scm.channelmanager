    <bpmn:sequenceFlow id="Flow_0cavkuc" sourceRef="Stamp_cancel_task" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_0i6yxb0" sourceRef="check_sign_type" targetRef="Signal_terminate_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('businessData_stampUser') != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0g2t8kk" sourceRef="Signal_terminate_task" targetRef="Confirm_signature" />
    <bpmn:sequenceFlow id="Flow_0pea8yi" sourceRef="Event_1fua73y" targetRef="Event_0m0is7t" />
    <bpmn:intermediateThrowEvent id="Signal_terminate_task" name="Signal terminate task">
