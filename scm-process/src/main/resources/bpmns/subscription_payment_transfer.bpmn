<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_05ht3zq" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.22.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:message id="Message_2m624ev" name="rejected" />
  <bpmn:message id="Message_12f7f6r" name="rejected" />
  <bpmn:collaboration id="Collaboration_Paymanet">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="cancelProcess" value="businessData_stampUser,businessData_signers" />
        <camunda:property name="cancelProcess1" value="{&#34;permission&#34;:[&#34;businessData_stampUser&#34;],&#34;actions&#34;:[{&#34;name&#34;:&#34;لغو&#34;,&#34;action&#34;:&#34;cancel&#34;}]}" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:participant id="payment_transfer_pool" name="payment Transfer" processRef="subscription_payment_transfer" />
  </bpmn:collaboration>
  <bpmn:process id="subscription_payment_transfer" name="Subscription Payment Transfer" isExecutable="true" camunda:versionTag="V3.2" camunda:historyTimeToLive="200">
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_02twc8e">
      <bpmn:lane id="automatic_payment_lane" name="Automatic Payment">
        <bpmn:flowNodeRef>successfully_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Automatic-transfer_payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rejected_log_lane" name="Failed End">
        <bpmn:flowNodeRef>end_failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="user_sign_line" name="User Sign">
        <bpmn:flowNodeRef>Gateway_0ylwxoj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm_signature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_sign_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>is_approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="user_action_line" name="User Action">
        <bpmn:extensionElements />
        <bpmn:flowNodeRef>start_payment_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waiting_for_action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_service_invoker</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="successfully_end" name="Successfully &#10;End">
      <bpmn:incoming>Flow_054h8m0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0ylwxoj" name="Is sign?">
      <bpmn:incoming>Flow_1y4mlkh</bpmn:incoming>
      <bpmn:outgoing>no_sign</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ffcqmr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Automatic-transfer_payment" name="Automatic Transfer Payment" camunda:class="ir.daneshrefah.scm.payment.service.AutomaticTransferPaymentService">
      <bpmn:incoming>natural_person</bpmn:incoming>
      <bpmn:incoming>Flow_1ffcqmr</bpmn:incoming>
      <bpmn:outgoing>Flow_054h8m0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_failed" name="Failed &#10;End">
      <bpmn:incoming>no_sign</bpmn:incoming>
      <bpmn:incoming>not_approved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Confirm_signature" name="Confirm Signature" camunda:assignee="${stampUser}">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="actions" value="[{&#34;name&#34;: &#34;امضا&#34;, &#34;action&#34;: &#34;sign&#34;}, {&#34;name&#34;: &#34;رد امضا&#34;, &#34;action&#34;: &#34;unSign&#34;}]" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>juridical_person</bpmn:incoming>
      <bpmn:outgoing>Flow_1y4mlkh</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="start_payment_process" name="Start Payment Process">
      <bpmn:documentation>فرایند انتقال وجه اشتراکی</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="jsonSchema" value="{&#34;$schema&#34;:&#34;https://json-schema.org/draft/2019-09/schema#&#34;,&#34;title&#34;:&#34;subscription_payment_transfer&#34;,&#34;description&#34;:&#34;subscription payment transfer&#34;,&#34;type&#34;:&#34;object&#34;,&#34;additionalProperties&#34;:true,&#34;required&#34;:[&#34;processKey&#34;,&#34;data&#34;],&#34;properties&#34;:{&#34;processKey&#34;:{&#34;type&#34;:&#34;string&#34;,&#34;description&#34;:&#34;Process Key&#34;,&#34;minLength&#34;:1},&#34;data&#34;:{&#34;type&#34;:&#34;object&#34;,&#34;properties&#34;:{&#34;transactionType&#34;:{&#34;type&#34;:&#34;string&#34;,&#34;enum&#34;:[&#34;Internal&#34;,&#34;BillBatch&#34;,&#34;Rtgs&#34;,&#34;Ach&#34;,&#34;InsuranceBatch&#34;]},&#34;signers&#34;:{&#34;type&#34;:&#34;array&#34;,&#34;minItems&#34;:1,&#34;items&#34;:[{&#34;type&#34;:&#34;string&#34;,&#34;minLength&#34;:10,&#34;maxLength&#34;:10}]},&#34;stampUser&#34;:{&#34;oneOf&#34;:[{&#34;type&#34;:&#34;string&#34;,&#34;minLength&#34;:10,&#34;maxLength&#34;:10},{&#34;type&#34;:&#34;string&#34;,&#34;maxLength&#34;:0}]},&#34;isLegal&#34;:{&#34;type&#34;:&#34;boolean&#34;}},&#34;required&#34;:[&#34;transactionType&#34;,&#34;signers&#34;]}}}             }                 }" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1oy2u1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="approved" name="Approved" sourceRef="is_approved" targetRef="check_sign_type">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('accept') != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="juridical_person" name="Juridical Person" sourceRef="check_sign_type" targetRef="Confirm_signature">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('stampUser') != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="natural_person" sourceRef="check_sign_type" targetRef="Automatic-transfer_payment" />
    <bpmn:sequenceFlow id="Flow_054h8m0" sourceRef="Automatic-transfer_payment" targetRef="successfully_end" />
    <bpmn:sequenceFlow id="Flow_1y4mlkh" sourceRef="Confirm_signature" targetRef="Gateway_0ylwxoj" />
    <bpmn:sequenceFlow id="no_sign" name="No" sourceRef="Gateway_0ylwxoj" targetRef="end_failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('unSign') != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ffcqmr" sourceRef="Gateway_0ylwxoj" targetRef="Automatic-transfer_payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('sign') != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="not_approved" name="Not&#10; Approved" sourceRef="is_approved" targetRef="end_failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('reject') != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1oy2u1t" sourceRef="start_payment_process" targetRef="process_service_invoker" />
    <bpmn:sequenceFlow id="Flow_1ebqrlm" sourceRef="waiting_for_action" targetRef="is_approved" />
    <bpmn:exclusiveGateway id="check_sign_type" name="Check Sign Type " default="natural_person">
      <bpmn:incoming>approved</bpmn:incoming>
      <bpmn:outgoing>juridical_person</bpmn:outgoing>
      <bpmn:outgoing>natural_person</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="is_approved" name="Is Approved?">
      <bpmn:incoming>Flow_1ebqrlm</bpmn:incoming>
      <bpmn:outgoing>approved</bpmn:outgoing>
      <bpmn:outgoing>not_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="waiting_for_action" name="Waiting for accepting or rejecting all users" camunda:assignee="${users}">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="actions" value="[{&#34;name&#34;: &#34;امضا&#34;, &#34;action&#34;: &#34;accept&#34;}, {&#34;name&#34;: &#34;رد امضا&#34;, &#34;action&#34;: &#34;reject&#34;}]" />
          <camunda:property name="extension" value="actions" />
          <camunda:property name="outputVariables" value="businessData_transactionData,businessData_transactionType" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i702li</bpmn:incoming>
      <bpmn:outgoing>Flow_1ebqrlm</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${businessData_signers}" camunda:elementVariable="users">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${execution.getVariable('reject') != null}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0i702li" sourceRef="process_service_invoker" targetRef="waiting_for_action" />
    <bpmn:serviceTask id="process_service_invoker" name="Process ServiceI nvoker" camunda:class="ir.daneshrefah.scm.process.integration.JavaDelegationService">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1oy2u1t</bpmn:incoming>
      <bpmn:outgoing>Flow_0i702li</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
