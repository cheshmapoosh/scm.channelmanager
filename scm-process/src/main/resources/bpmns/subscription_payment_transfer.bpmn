          <camunda:property name="jsonSchema" value="{&#34;$schema&#34;:&#34;https://json-schema.org/draft/2019-09/schema#&#34;,&#34;title&#34;:&#34;stam cancel Task&#34;,&#34;description&#34;:&#34;cancel task&#34;,&#34;type&#34;:&#34;object&#34;,&#34;additionalProperties&#34;:true,&#34;required&#34;:[&#34;action&#34;],&#34;properties&#34;:{&#34;action&#34;:{&#34;type&#34;:&#34;string&#34;,&#34;description&#34;:&#34;Action&#34;,&#34;enum&#34;:[&#34;cancel&#34;]}}}" />
